model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_ProTooling = ["DevMode"]

ref table Appointments
ref table Billing
ref table Diagnoses
ref table Doctors
ref table Medications
ref table Patients
ref table Date
ref table 'Sim Cut'
ref table 'Sim Rebook'
ref table _Measures

ref cultureInfo en-US

