table Appointments
	lineageTag: 0b1b04dd-f963-4d01-931e-6527875b8834

	column appointment_id
		dataType: int64
		isHidden
		lineageTag: f2fd27f7-6d00-4ba9-b235-0e84c296e41f
		summarizeBy: none
		sourceColumn: appointment_id

	column patient_id
		dataType: int64
		isHidden
		lineageTag: 0dc5429f-2340-4ccb-b605-ee4ad45f6919
		summarizeBy: none
		sourceColumn: patient_id

	column doctor_id
		dataType: int64
		isHidden
		lineageTag: b9a7dab3-4166-481f-9a85-8faf5bc9e74f
		summarizeBy: none
		sourceColumn: doctor_id

	column appointment_date
		dataType: dateTime
		formatString: Short Date
		lineageTag: 41c3402a-1322-4516-83fd-89a5e2425180
		summarizeBy: none
		sourceColumn: appointment_date

	column status
		dataType: string
		lineageTag: b70d0b12-2388-41f4-aa04-0418377ac25e
		summarizeBy: none
		sourceColumn: status

	partition Appointments = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "appointments.csv"),[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    H = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    K = Table.SelectColumns(H,{"appointment_id","patient_id","doctor_id","appointment_date","status"}),
				    T = Table.TransformColumnTypes(K,{{"appointment_id", Int64.Type},{"patient_id", Int64.Type},{"doctor_id", Int64.Type},{"appointment_date", type date},{"status", type text}})
				in
				    T

